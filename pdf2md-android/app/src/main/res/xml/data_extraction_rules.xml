<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction regels voor Android 12+ (API 31+).
    Vervangt fullBackupContent op nieuwere toestellen.
    Zelfde logica: cacheDir altijd uitgesloten, filesDir/images opt-in.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="cache" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="cache" path="." />
    </device-transfer>
</data-extraction-rules>
